# Copy to .env and fill in. These values are public by design (they ship inside the app);
# data is protected by row-level security on the server. Never put the service_role key here.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client ID (type "Web application").
# Leave empty to hide the "Continue with Google" button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
