{
  "expo": {
    "name": "DayPrism",
    "slug": "dayprism",
    "version": "1.6.0",
    "scheme": "dayprism",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4f6fa",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.dayprism"
    },
    "android": {
      "package": "app.dayprism",
      "versionCode": 8,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2a78d6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f4f6fa",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0b1020"
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2a78d6"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "DayPrism Beta Today",
              "description": "Up to four tiles you choose, each a one-tap shortcut.",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Streak",
              "label": "DayPrism Beta Streak",
              "description": "Your day streak. Lights up once today is logged.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/streak-widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
