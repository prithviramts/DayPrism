---
import Icon from './Icon.astro';
interface Props { headline: string; truths: { icon: string; title: string; text: string }[] }
const { headline, truths } = Astro.props;
---
<section class="problem section" aria-labelledby="problem-title">
  <div class="wrap">
    <h2 id="problem-title" class="h2 problem-title" data-reveal>{headline}</h2>
    <ul class="truths" role="list">
      {truths.map((t) => (
        <li class="truth" data-reveal>
          <span class="truth-icon"><Icon name={t.icon} size={22} /></span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .problem-title { max-width: 16ch; }
  .truths { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: clamp(1.5rem, 3vw, 3rem); margin-top: clamp(3rem, 6vw, 5rem); }
  .truth { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .truth-icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    color: var(--sun-ink);
    background: color-mix(in srgb, var(--sun) 13%, transparent);
    margin-bottom: 1.1rem;
  }
  :global([data-theme='dark']) .truth-icon { color: var(--moon); background: color-mix(in srgb, var(--moon) 10%, transparent); }
  h3 { font-size: var(--h3); margin-bottom: 0.5rem; letter-spacing: -0.015em; }
  p { color: var(--ink-2); }
</style>
