---
// The sun/moon theme switch. Pressing it rotates the dial: the sun sets along an arc and the
// moon rises. It's a real switch for assistive tech (role="switch" + aria-checked).
---
<button class="theme-dial" type="button" role="switch" aria-checked="false" aria-label="Dark theme" data-theme-toggle>
  <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="dial-sky"><rect x="0" y="0" width="40" height="26" /></clipPath>
    </defs>
    <g clip-path="url(#dial-sky)">
      <g class="dial-arm">
        <g class="dial-sun">
          <circle cx="20" cy="13" r="4.6" />
          <path d="M20 4.5v1.8M11.5 13H9.7M30.3 13h-1.8M14 7l1.2 1.2M26 7l-1.2 1.2" />
        </g>
        <path class="dial-moon" transform="rotate(180 20 26)" d="M21.5 8.2A5 5 0 1 0 24.8 15.2A4.2 4.2 0 0 1 21.5 8.2Z" />
      </g>
    </g>
    <path class="dial-horizon" d="M8 26.5h24" />
  </svg>
</button>

<script>
  import '../scripts/theme';
</script>

<style>
  .theme-dial {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s var(--ease-light);
  }
  .theme-dial:hover { border-color: color-mix(in srgb, var(--ink) 30%, transparent); }
  .theme-dial:active { transform: scale(0.95); }
  svg { overflow: visible; }
  .dial-arm {
    transform-origin: 20px 26px;
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  :global([data-theme='dark']) .dial-arm { transform: rotate(180deg); }
  .dial-sun circle { fill: var(--sun); }
  .dial-sun path { stroke: var(--sun); stroke-width: 1.6; stroke-linecap: round; fill: none; }
  /* The moon sits upside-down below the horizon, so it's upright once the arm has turned. */
  .dial-moon { fill: var(--moon); }
  :global(:root:not([data-theme='dark'])) .dial-moon { fill: var(--brand-2); }
  .dial-horizon { stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; opacity: 0.55; }
</style>
