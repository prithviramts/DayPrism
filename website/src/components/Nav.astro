---
import Logo from './Logo.astro';
import ThemeDial from './ThemeDial.astro';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = home ? '' : '/';
const links = [
  { href: `${base}#how`, text: 'How it works' },
  { href: `${base}#privacy`, text: 'Privacy' },
  { href: `${base}#pricing`, text: 'Pricing' },
  { href: `${base}#faq`, text: 'FAQ' },
];
---
<header class="nav reveal-nav" data-nav>
  <nav class="nav-inner wrap" aria-label="Main">
    <a class="brand" href="/" aria-label="DayPrism home">
      <Logo size={30} />
      <span class="brand-name">DayPrism</span>
    </a>
    <!-- On phones this list becomes a drop-down panel, opened by the Menu button. -->
    <ul class="nav-links" id="nav-menu">
      {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
    </ul>
    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" data-menu-btn>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path class="bars" d="M4 7h16M4 12h16M4 17h16" />
        <path class="cross" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <ThemeDial />
  </nav>
</header>

<script>
  // Give the bar a frosted background once the page has scrolled past the top.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const update = () => nav.classList.toggle('nav-solid', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });

    // Phone menu: a simple disclosure. Opens below the bar; closes on a link, Escape, a tap
    // outside, or when the screen gets wide enough to show the links inline.
    const btn = nav.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
    const menu = nav.querySelector<HTMLElement>('#nav-menu')!;
    const setOpen = (open: boolean, focusButton = false) => {
      nav.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
      if (open) menu.querySelector('a')?.focus();
      else if (focusButton) btn.focus();
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.hasAttribute('data-open')) setOpen(false, true); });
    document.addEventListener('pointerdown', (e) => { if (nav.hasAttribute('data-open') && !nav.contains(e.target as Node)) setOpen(false); });
    matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav.nav-solid {
    background: color-mix(in srgb, var(--sky) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--line);
  }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 1.5rem; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .brand :global(.logo) { border-radius: 8px; }
  .nav-links { display: flex; gap: 0.25rem; margin-left: auto; list-style: none; }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .nav-links a:hover { background: color-mix(in srgb, var(--ink) 7%, transparent); }
  .nav :global(.theme-dial) { margin-left: 0.25rem; }
  .menu-btn { display: none; }
  @media (max-width: 760px) {
    .menu-btn {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-left: auto;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: color-mix(in srgb, var(--surface) 75%, transparent);
      color: var(--ink);
      cursor: pointer;
    }
    .menu-btn path { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
    .menu-btn .cross { display: none; }
    .nav[data-open] .menu-btn .bars { display: none; }
    .nav[data-open] .menu-btn .cross { display: inline; }
    .nav :global(.theme-dial) { margin-left: 0.25rem; }

    .nav-links {
      display: none;
      position: absolute;
      top: calc(var(--nav-h) - 0.25rem);
      left: var(--gutter);
      right: var(--gutter);
      margin: 0;
      padding: 0.5rem;
      flex-direction: column;
      gap: 0.15rem;
      border-radius: var(--radius);
      background: var(--surface);
      border: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
    }
    .nav[data-open] .nav-links { display: flex; animation: menu-in 0.22s var(--ease-light); }
    .nav[data-open] { background: var(--sky); border-bottom-color: var(--line); }
    .nav-links a { display: flex; min-height: 48px; padding: 0 1rem; border-radius: 12px; font-size: 1.05rem; }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
</style>
