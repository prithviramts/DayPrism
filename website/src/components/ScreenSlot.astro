---
// Shows a real app screenshot if one exists in src/assets/screens/<name>.png (or .jpg/.webp),
// converted to AVIF/WebP at build time. Otherwise it shows the HTML version of that screen
// passed in as the slot. Drop real screenshots in and rebuild: nothing else to change.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: 'today' | 'timeline' | 'insights'; alt: string }
const { name, alt } = Astro.props;
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.{png,jpg,jpeg,webp}', { eager: true });
const shot = Object.entries(found).find(([path]) => path.split('/').pop()!.split('.')[0] === name)?.[1].default;
---
{shot ? (
  <Picture src={shot} alt={alt} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 960px) 320px, 70vw" class="screen-shot" />
) : (
  <div class="screen" role="img" aria-label={alt}><slot /></div>
)}

<style>
  .screen { height: 100%; }
  .screen-shot, .screen-shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
