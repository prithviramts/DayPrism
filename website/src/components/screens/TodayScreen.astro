---
import './screens.css';
import AppIcon from './AppIcon.astro';
import TabBar from './TabBar.astro';
// The Today screen as in DayPrism 1.6, with sample values.
const tiles = [
  { c: 'checkin', icon: 'bolt', label: 'Energy', value: '4/5', sub: 'at 9:40 AM', done: true },
  { c: 'sleep', icon: 'moon', label: 'Sleep', value: '7h 20m', sub: 'quality 4/5', done: true, ring: 'p80' },
  { c: 'water', icon: 'drop', label: 'Water', value: '5/8', sub: 'glasses', ring: 'p62' },
  { c: 'meal', icon: 'meal', label: 'Meals', value: '1/3', sub: 'breakfast', ring: 'p33' },
  { c: 'caffeine', icon: 'cup', label: 'Caffeine', value: '80 mg', sub: 'of 400 mg max', ring: 'p20' },
  { c: 'activity', icon: 'play', label: 'Activity', value: 'Start', sub: 'a timer' },
  { c: 'reflect', icon: 'pencil', label: 'Reflect', value: '–', sub: 'End of day' },
  { c: 'steps', icon: 'steps', label: 'Steps', value: '4,210', sub: 'of 8,000', ring: 'p53' },
];
---
<div class="app">
  <div class="app-status"><span>9:41</span><span><i></i><i></i></span></div>
  <div class="app-head">
    <div><p class="app-date">Friday 2 October</p><p class="app-title">Good morning</p></div>
    <span class="app-streak c-meal"><AppIcon name="flame" />12</span>
  </div>
  <div class="app-sect"><b>Your day</b><span>long-press for more</span><span class="app-link">Customize</span></div>
  <div class="app-tiles">
    {tiles.map((t) => (
      <div class:list={['app-tile', `c-${t.c}`, { done: t.done }]}>
        {t.ring ? <div class:list={['app-ico', 'app-ring', t.ring]}><span><AppIcon name={t.icon} /></span></div> : <div class="app-ico"><AppIcon name={t.icon} /></div>}
        {t.done && <span class="app-check"><AppIcon name="check" /></span>}
        <p class="app-label">{t.label}</p>
        <p class="app-value">{t.value}</p>
        <p class="app-sub">{t.sub}</p>
      </div>
    ))}
  </div>
  <TabBar active="today" />
</div>
