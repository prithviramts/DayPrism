---
// Hero: the sunrise (light theme) or moonrise over the sleeping town (dark theme).
//
// Layers, back to front:
//  1. .hero-sky   CSS gradients, sun glow, moon, stars and the SVG town. Paints instantly, needs
//                 no JavaScript, and is the whole show on low-power devices ("low" level).
//  2. [data-sky-stage]  the WebGL scene (rays, shader sky, 3D town), mounted later by
//                 scripts/sky-loader.ts on capable devices, fading in over layer 1.
//  3. .hero-content  the wordmark, headline and buttons (real HTML text, readable immediately).
//
// The entrance is pure CSS animation, keyed off the `rising` class the boot script sets on
// <html>; scripts/entrance.ts only skips it on scroll, click or key press.
import Town from './Town.astro';
import PlayBadge from './PlayBadge.astro';
import Icon from './Icon.astro';

interface Props { headline: string; sub: string; secondary: string }
const { headline, sub, secondary } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-sky" aria-hidden="true">
    <div class="sky sky-day"></div>
    <div class="sky sky-warm"></div>
    <div class="sky sky-pre"></div>
    <div class="sky sky-night"></div>
    <div class="stars stars-a"></div>
    <div class="stars stars-b"></div>
    <div class="moon"></div>
    <Town class="hero-town" />
    <Town class="hero-town town-night" />
  </div>

  <div
    class="sky-stage"
    data-sky-stage
    role="img"
    aria-label="An animated sky: the sun rises behind the DayPrism wordmark over a small town."
    aria-describedby="sky-text"
  ></div>
  <p id="sky-text" class="visually-hidden" data-sky-text>
    Light theme: at dawn the sun rises behind the word DayPrism, sending soft rays of light across a
    sky that warms from violet to rose to morning blue, while the windows of a small town go dark
    as the day begins. Dark theme: the moon rises over the same town and its windows light up one
    by one as everyone's day ends.
  </p>

  <div class="hero-fade" aria-hidden="true"></div>

  <div class="hero-content wrap">
    <h1 id="hero-title" class="hero-title">
      <span class="wm" data-wordmark>
        <span class="wm-sun" aria-hidden="true"></span>
        <span class="wm-base">DayPrism</span>
        <span class="wm-fill" aria-hidden="true"><span class="wm-fill-inner">DayPrism</span></span>
      </span>
      <span class="headline reveal r1">{headline}</span>
    </h1>
    <p class="sub reveal r2">{sub}</p>
    <div class="cta reveal r3">
      <PlayBadge />
      <a class="btn btn-ghost" href="#how">{secondary} <Icon name="arrow-down" size={18} /></a>
    </div>
  </div>
</section>

<script>
  import '../scripts/entrance';
  import '../scripts/sky-loader';
</script>

<style>
  .hero {
    --town-h: clamp(140px, 28vh, 300px);
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: max(100svh, 620px);
    padding: calc(var(--nav-h) + 2rem) 0 calc(var(--town-h) * 0.72);
    overflow: hidden;
    text-align: center;
  }

  /* ---------- Layer 1: CSS sky ---------- */
  .hero-sky, .sky, .stars, .sky-stage { position: absolute; inset: 0; }
  .hero-sky { z-index: -3; }
  .sky { transition: opacity 1.4s var(--ease-light); will-change: opacity; }
  .sky-day { background: linear-gradient(180deg, #bcd3f1 0%, #d7e5f7 42%, #efe9ec 74%, #fbe2cd 100%); }
  .sky-warm { background: linear-gradient(180deg, #24205a 0%, #5b3a9c 34%, #c2416a 62%, #ff8a4a 84%, #ffc58a 100%); opacity: 0; }
  .sky-pre { background: radial-gradient(120% 60% at 50% 100%, #2b2752 0%, transparent 60%), linear-gradient(180deg, #0b1020 0%, #10152f 55%, #1a1f3a 100%); opacity: 0; }
  .sky-night { background: radial-gradient(70% 50% at 74% 26%, rgba(223, 231, 255, 0.10), transparent 70%), linear-gradient(180deg, #060a16 0%, #0b1020 45%, #131a33 80%, #1b2240 100%); opacity: 0; }
  :global([data-theme='dark']) .sky-night { opacity: 1; }

  .stars {
    opacity: 0;
    transition: opacity 1.6s var(--ease-light);
    background-image:
      radial-gradient(1.2px 1.2px at 12% 18%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 27% 8%, #fff 50%, transparent 52%),
      radial-gradient(1.4px 1.4px at 41% 22%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 63% 12%, #fff 50%, transparent 52%),
      radial-gradient(1.2px 1.2px at 86% 16%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 92% 34%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 6% 38%, #fff 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 55% 30%, #fff 50%, transparent 52%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 62%);
  }
  .stars-b {
    background-image:
      radial-gradient(1px 1px at 18% 28%, #fff 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 34% 14%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 48% 6%, #fff 50%, transparent 52%),
      radial-gradient(1.2px 1.2px at 71% 24%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 79% 6%, #fff 50%, transparent 52%),
      radial-gradient(1px 1px at 97% 12%, #fff 50%, transparent 52%);
  }
  :global([data-theme='dark']) .stars-a { opacity: 0.9; animation: twinkle 5s ease-in-out infinite alternate; }
  :global([data-theme='dark']) .stars-b { opacity: 0.6; animation: twinkle 7s 1.5s ease-in-out infinite alternate-reverse; }
  @keyframes twinkle { from { opacity: 0.25; } to { opacity: 0.95; } }

  .moon {
    position: absolute;
    /* High and to the side, clear of the (long) DayPrism wordmark on every screen size. */
    top: max(11%, calc(var(--nav-h) + 1.5rem));
    right: 7%;
    width: clamp(40px, 5.5vw, 80px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 36%, #ffffff 0%, var(--moon) 55%, #b9c6ef 100%);
    box-shadow: 0 0 40px 8px rgba(223, 231, 255, 0.35), 0 0 160px 50px rgba(150, 170, 255, 0.14);
    opacity: 0;
    transform: translateY(40vh);
    transition: transform 2.2s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 1.2s var(--ease-light);
  }
  :global([data-theme='dark']) .moon { opacity: 1; transform: none; }

  /* The town, twice: a daylight copy, and a night copy (deep navy, lit windows) on top that
     cross-fades with the theme. Fading a whole layer is cheap; recolouring SVG is not. */
  .hero-sky :global(.hero-town) { position: absolute; left: 0; bottom: 0; width: 100%; height: var(--town-h); }
  .hero-sky :global(.town-l0) { fill: #c3cde4; }
  .hero-sky :global(.town-l1) { fill: #a9b6d3; }
  .hero-sky :global(.town-l2) { fill: #8e9cc0; }
  .hero-sky :global(.hero-town:not(.town-night) .town-windows) { display: none; }
  .hero-sky :global(.town-night) { opacity: 0; transition: opacity 1.6s var(--ease-light); will-change: opacity; }
  .hero-sky :global(.town-night .town-l0) { fill: #1a2242; }
  .hero-sky :global(.town-night .town-l1) { fill: #131a35; }
  .hero-sky :global(.town-night .town-l2) { fill: #0d1329; }
  :global([data-theme='dark']) .hero-sky :global(.town-night) { opacity: 1; }

  /* ---------- Layer 2: WebGL stage ---------- */
  .sky-stage { z-index: -2; opacity: 0; transition: opacity 0.8s var(--ease-light); }
  .sky-stage :global(canvas) { width: 100% !important; height: 100% !important; }
  :global(.sky-live) .sky-stage { opacity: 1; }

  /* Mist at the bottom so the hero melts into the page. */
  .hero-fade {
    position: absolute;
    inset: auto 0 0;
    height: 14vh;
    z-index: -1;
    background: linear-gradient(180deg, transparent, var(--sky));
    pointer-events: none;
  }

  /* ---------- Layer 3: content ---------- */
  .hero-content { display: grid; justify-items: center; gap: clamp(1rem, 2.4vw, 1.6rem); }
  .hero-title { display: grid; justify-items: center; gap: clamp(0.6rem, 1.6vw, 1.1rem); }

  .wm {
    position: relative;
    isolation: isolate;
    display: inline-block;
    font-size: clamp(3.6rem, 15.5vw, 11.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.95;
    /* Room for the "y" descender and the last letter's overhang. Both copies of the word must use
       the same padding: background-clip:text only paints inside the box, so a smaller box cuts
       the tail of the "y" off. */
    --wm-pad: 0 0.08em 0.3em;
    padding: var(--wm-pad);
    margin-bottom: -0.22em;
  }
  .wm-base { color: transparent; -webkit-text-stroke: 1.5px transparent; }
  .wm-fill { position: absolute; inset: 0; overflow: hidden; }
  .wm-fill-inner {
    display: block;
    padding: var(--wm-pad);
    background: linear-gradient(180deg, #22306e 0%, #4a3aa7 40%, #b83f6e 82%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global([data-theme='dark']) .wm-fill-inner { background-image: linear-gradient(180deg, #ffffff 0%, #e6ecff 45%, #a9b8f5 82%); }

  /* The light source behind the wordmark (the WebGL scene draws its own sun instead). */
  .wm-sun {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 55%;
    width: 150%;
    aspect-ratio: 1.6;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 244, 222, 0.95) 0%, rgba(255, 206, 150, 0.55) 30%, rgba(255, 170, 110, 0.18) 60%, transparent 100%);
    pointer-events: none;
    transition: opacity 1.2s var(--ease-light);
  }
  :global([data-theme='dark']) .wm-sun { background: radial-gradient(closest-side, rgba(170, 190, 255, 0.22) 0%, rgba(120, 140, 230, 0.08) 50%, transparent 100%); }
  :global(.sky-live) .wm-sun { opacity: 0; }

  .headline { font-size: clamp(1.6rem, 3.8vw, 3rem); letter-spacing: -0.03em; max-width: 20ch; }
  .sub { font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem); color: var(--ink-2); max-width: 34rem; }
  :global([data-theme='light']) .sub { color: #334155; } /* a touch darker over the bright sky */
  .cta { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: center; gap: 1rem 1.25rem; margin-top: 0.5rem; }
  .cta :global(.play-wrap) { justify-items: center; }

  @media (max-width: 560px) {
    .hero { text-align: center; }
    .cta { flex-direction: column; align-items: center; }
  }

  /* ==========================================================================
     The entrance. Only while <html> has the `rising` class (first visit this session, motion
     allowed). Everything animates transform/opacity, except three tiny SVG fills.
     ========================================================================== */
  :global(.rising) .sky { transition: none; }

  /* Light theme: pre-dawn → violet → rose → amber → morning. */
  :global(.rising[data-theme='light']) .sky-pre { animation: fade-out 1.1s 0.2s ease-in-out both; }
  :global(.rising[data-theme='light']) .sky-warm { animation: warm 2.5s linear both; }
  :global(.rising[data-theme='light']) .wm-sun { animation: sun-rise 2.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  :global(.rising[data-theme='light']) .hero-sky :global(.town-night) { animation: fade-out 2.2s 0.3s ease-in-out both; }

  /* Dark theme: the moon rises and windows light up one by one. */
  :global(.rising[data-theme='dark']) .moon { animation: moon-rise 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  :global(.rising[data-theme='dark']) .stars { animation: fade-in 2s 0.3s both; }
  :global(.rising[data-theme='dark']) .hero-sky :global(.wb) { animation: lights-on 0.5s both; }

  /* Both: the wordmark fills with light from the bottom up, then the page appears. */
  :global(.rising) .wm-base { animation: outline 1.2s 1.5s ease-out both; }
  :global(.rising) .wm-fill { animation: fill-window 1.6s 0.45s cubic-bezier(0.45, 0, 0.2, 1) both; }
  :global(.rising) .wm-fill-inner { animation: fill-counter 1.6s 0.45s cubic-bezier(0.45, 0, 0.2, 1) both; }
  :global(.rising) .reveal { animation: reveal 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  :global(.rising) .r1 { animation-delay: 1.25s; }
  :global(.rising) .r2 { animation-delay: 1.5s; }
  :global(.rising) .r3 { animation-delay: 1.7s; }

  @keyframes fade-out { to { opacity: 0; } from { opacity: 1; } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes warm { 0%, 42% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sun-rise { from { transform: translateY(32vh) scale(0.55); opacity: 0.25; } }
  @keyframes moon-rise { from { transform: translateY(40vh); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
  @keyframes lights-on { from { opacity: 0; } to { opacity: 1; } }
  @keyframes outline {
    from { color: rgba(255, 255, 255, 0.05); -webkit-text-stroke-color: rgba(223, 231, 255, 0.6); }
    to { color: transparent; -webkit-text-stroke-color: transparent; }
  }
  @keyframes fill-window { from { transform: translateY(100%); } }
  @keyframes fill-counter { from { transform: translateY(-100%); } }
  @keyframes reveal { from { opacity: 0; transform: translateY(14px); } }

  /* Window buckets light (and go out) in sequence, like a wave across the town. */
  .hero-sky :global(.wb) { fill: var(--window); opacity: 0; transition: opacity 0.5s; }
  :global([data-theme='dark']) .hero-sky :global(.wb),
  :global(.rising[data-theme='light']) .hero-sky :global(.wb) { opacity: 1; }
  .hero-sky :global(.wb0) { transition-delay: 0.5s; animation-delay: 0.5s !important; }
  .hero-sky :global(.wb1) { transition-delay: 0.64s; animation-delay: 0.64s !important; }
  .hero-sky :global(.wb2) { transition-delay: 0.78s; animation-delay: 0.78s !important; }
  .hero-sky :global(.wb3) { transition-delay: 0.92s; animation-delay: 0.92s !important; }
  .hero-sky :global(.wb4) { transition-delay: 1.06s; animation-delay: 1.06s !important; }
  .hero-sky :global(.wb5) { transition-delay: 1.2s; animation-delay: 1.2s !important; }
  .hero-sky :global(.wb6) { transition-delay: 1.34s; animation-delay: 1.34s !important; }
  .hero-sky :global(.wb7) { transition-delay: 1.48s; animation-delay: 1.48s !important; }
  .hero-sky :global(.wb8) { transition-delay: 1.62s; animation-delay: 1.62s !important; }
  .hero-sky :global(.wb9) { transition-delay: 1.76s; animation-delay: 1.76s !important; }
  .hero-sky :global(.wb10) { transition-delay: 1.9s; animation-delay: 1.9s !important; }
  .hero-sky :global(.wb11) { transition-delay: 2.04s; animation-delay: 2.04s !important; }
</style>
